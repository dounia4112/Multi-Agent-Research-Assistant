GROQ_API_KEY=your_groq_key_here
TAVILY_API_KEY=your_tavily_key_here

# Optional: Postgres connection string to keep a history of runs
DATABASE_URL=

# Optional: only if index.html is hosted on another domain than the API (comma-separated)
ALLOWED_ORIGINS=

# Optional: per-visitor rate limit (default 5 runs per 10 minutes)
RATE_LIMIT_RUNS=5
RATE_LIMIT_WINDOW_SECONDS=600

# Optional: override the Groq models (https://console.groq.com/docs/models)
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_SMART_MODEL=openai/gpt-oss-120b
